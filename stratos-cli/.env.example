# Stratos CLI: environment variables. Copy to .env for local use; NEVER commit real values.
# Settings are layered: CLI options > environment > project config > user config > org defaults.

# --- Settings (STRATOS_<SECTION>__<KEY>) -------------------------------------------------
# STRATOS_API__ENDPOINT=https://api.stratos.example
# STRATOS_GITHUB__ORGANIZATION=Stratos-Technologies-fzco
# STRATOS_AUTH__ISSUER=https://login.example.com
# STRATOS_AUTH__CLIENT_ID=
# STRATOS_AI__PROVIDER=claude            # claude | openai | azure-openai
# STRATOS_AI__MODEL=claude-sonnet-5
# STRATOS_POLICY__ALLOW_PUBLIC_REPOS=false

# --- Credentials (read from the environment, never stored in configuration files) -------
# GITHUB_TOKEN=                          # or sign in with `gh auth login`
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AZURE_OPENAI_API_KEY=
# CONFLUENCE_EMAIL=
# CONFLUENCE_API_TOKEN=
# SHAREPOINT_TOKEN=                      # Microsoft Graph access token (or MS_GRAPH_TOKEN)

# --- Diagnostics --------------------------------------------------------------------------------
# STRATOS_DEBUG=1                        # show tracebacks for unexpected errors
